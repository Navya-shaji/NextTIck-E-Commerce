        <%- include ("../../views/partials/user/footer.ejs") %>

          <!-- Floating UX Elements -->
          <button id="backToTop" class="floating-btn back-to-top"
            onclick="window.scrollTo({top: 0, behavior: 'smooth'})">
            <i class="fas fa-arrow-up"></i>
          </button>

          <style>
            .floating-btn {
              position: fixed;
              bottom: 30px;
              z-index: 1000;
              border: none;
              display: flex;
              align-items: center;
              justify-content: center;
              transition: all 0.4s cubic-bezier(0.16, 1, 0.3, 1);
              cursor: pointer;
              box-shadow: 0 10px 30px rgba(0, 0, 0, 0.15);
            }

            .back-to-top {
              right: 30px;
              width: 50px;
              height: 50px;
              background: var(--primary-color);
              color: var(--white);
              border-radius: 50%;
              opacity: 0;
              visibility: hidden;
              transform: translateY(20px);
            }

            .back-to-top.visible {
              opacity: 1;
              visibility: visible;
              transform: translateY(0);
            }

            @media (max-width: 768px) {
              .floating-btn {
                bottom: 20px;
              }
            }
          </style>

          <!-- Scripts -->
          <script src="https://cdn.jsdelivr.net/npm/sweetalert2@11"></script>
          <script src="https://unpkg.com/aos@next/dist/aos.js"></script>
          <script>
            AOS.init({
              duration: 1000,
              once: true,
              easing: 'ease-out-cubic'
            });

            // Banner Carousel Functionality
            let currentBannerIndex = 0;
            let bannerInterval;
            const bannerSlides = document.querySelectorAll('.banner-slide');
            const bannerDots = document.querySelectorAll('.carousel-dot');

            function showBanner(index) {
              if (bannerSlides.length === 0) return;
              bannerSlides.forEach(slide => slide.classList.remove('active'));
              bannerDots.forEach(dot => dot.classList.remove('active'));
              bannerSlides[index].classList.add('active');
              if (bannerDots[index]) {
                bannerDots[index].classList.add('active');
              }
            }

            function changeBanner(direction) {
              if (bannerSlides.length === 0) return;
              currentBannerIndex = (currentBannerIndex + Number(direction) + bannerSlides.length) % bannerSlides.length;
              showBanner(currentBannerIndex);
              resetBannerInterval();
            }

            function goToBanner(index) {
              currentBannerIndex = Number(index);
              showBanner(currentBannerIndex);
              resetBannerInterval();
            }

            function resetBannerInterval() {
              clearInterval(bannerInterval);
              if (bannerSlides.length > 1) {
                bannerInterval = setInterval(() => changeBanner(1), 6000);
              }
            }

            // Initialize
            if (bannerSlides.length > 0) resetBannerInterval();

            window.addEventListener('scroll', () => {
              const backToTop = document.getElementById('backToTop');
              if (backToTop) {
                if (window.scrollY > 500) backToTop.classList.add('visible');
                else backToTop.classList.remove('visible');
              }
            });

            function addToCart(event, productId) {
              const btn = event.currentTarget || event.target;
              const originalContent = btn.innerHTML;
              btn.style.pointerEvents = 'none';
              btn.innerHTML = '<i class="fas fa-spinner fa-spin"></i>';

              fetch("/addToCart", {
                method: "POST",
                headers: { 'Content-Type': 'application/json' },
                body: JSON.stringify({ productId, quantity: 1 })
              })
                .then(res => res.json())
                .then(response => {
                  if (response.success) {
                    Swal.fire({
                      icon: 'success',
                      title: 'Added!',
                      text: 'Product successfully added to your bag',
                      showConfirmButton: false,
                      timer: 1500,
                      position: 'top-end',
                      toast: true
                    });
                    if (response.cartCount !== undefined) {
                      $('.cart-count').text(response.cartCount);
                    }
                  } else if (response.status === "already_in_cart") {
                    Swal.fire({
                      icon: 'info',
                      title: 'Already in your bag',
                      text: response.message,
                      showCancelButton: true,
                      confirmButtonColor: '#000',
                      cancelButtonColor: '#6c757d',
                      confirmButtonText: 'Go to Cart',
                      cancelButtonText: 'Continue Shopping'
                    }).then((result) => {
                      if (result.isConfirmed) {
                        window.location.href = '/cart';
                      }
                    });
                  } else {
                    Swal.fire({
                      icon: 'info',
                      title: 'Note',
                      text: response.message
                    });
                  }
                })
                .catch((err) => {
                  console.error('Add to cart error:', err);
                  Swal.fire({
                    icon: 'error',
                    title: 'Oops...',
                    text: 'Something went wrong while adding to cart'
                  });
                })
                .finally(() => {
                  btn.style.pointerEvents = 'auto';
                  btn.innerHTML = originalContent;
                });
            }

            function addToWishlist(event, productId) {
              const btn = event.currentTarget || event.target;
              const originalContent = btn.innerHTML;
              btn.style.pointerEvents = 'none';

              fetch('/addToWishlist', {
                method: 'POST',
                headers: { 'Content-Type': 'application/json' },
                body: JSON.stringify({ productId })
              })
                .then(res => res.json())
                .then(response => {
                  if (response.status) {
                    const isAdded = response.action === 'added';
                    const icon = btn.querySelector('i');
                    if (icon) {
                      icon.className = isAdded ? 'fas fa-heart' : 'far fa-heart';
                    }
                    Swal.fire({
                      icon: 'success',
                      title: isAdded ? 'Saved!' : 'Removed!',
                      text: isAdded ? 'Added to your wishlist' : 'Removed from your wishlist',
                      showConfirmButton: false,
                      timer: 1500,
                      toast: true,
                      position: 'top-end'
                    });
                  } else {
                    Swal.fire({
                      icon: 'info',
                      title: 'Login Required',
                      text: response.message || 'Please sign in to manage your wishlist',
                      showCancelButton: true,
                      confirmButtonText: 'Sign In',
                      confirmButtonColor: '#1a1a1a'
                    }).then(res => {
                      if (res.isConfirmed) window.location.href = '/login';
                    });
                  }
                })
                .catch((err) => {
                  console.error('Wishlist error:', err);
                  Swal.fire({
                    icon: 'error',
                    title: 'Error',
                    text: 'Failed to update wishlist'
                  });
                })
                .finally(() => {
                  btn.style.pointerEvents = 'auto';
                });
            }
          </script>