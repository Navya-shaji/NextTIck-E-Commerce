<%- include ("../../views/partials/user/header.ejs") %>

  <head>
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.0.0/css/all.min.css">
    <style>
      :root {
        --primary-color: #0f1111;
        --secondary-color: #f7f8f8;
        --accent-color: #d4af37;
        --accent-glow: rgba(212, 175, 55, 0.3);
        --text-color: #1a1a1a;
        --light-text: #757575;
        --white: #ffffff;
        --font-heading: 'Cinzel', serif;
        --font-body: 'Outfit', sans-serif;
        --glass-bg: rgba(255, 255, 255, 0.8);
        --glass-border: rgba(255, 255, 255, 0.2);
        --shadow-soft: 0 20px 40px rgba(0, 0, 0, 0.05);
        --shadow-strong: 0 30px 60px rgba(0, 0, 0, 0.12);
      }

      body {
        font-family: var(--font-body);
        color: var(--text-color);
        background-color: var(--white);
        overflow-x: hidden;
      }

      /* Custom Scrollbar */
      ::-webkit-scrollbar {
        width: 8px;
      }

      ::-webkit-scrollbar-track {
        background: #f1f1f1;
      }

      ::-webkit-scrollbar-thumb {
        background: #0f1111;
        border-radius: 10px;
      }

      ::-webkit-scrollbar-thumb:hover {
        background: var(--accent-color);
      }

      /* Hero Section */
      .hero-section {
        position: relative;
        height: 100vh;
        display: flex;
        align-items: center;
        background: #0f1111;
        color: var(--white);
        overflow: hidden;
      }

      .hero-video-bg {
        position: absolute;
        top: 0;
        left: 0;
        width: 100%;
        height: 100%;
        object-fit: cover;
        opacity: 0.6;
        filter: grayscale(0.5);
      }

      .hero-content {
        position: relative;
        z-index: 10;
        padding-left: 10%;
        max-width: 800px;
      }

      .hero-subtitle {
        font-size: 14px;
        letter-spacing: 8px;
        text-transform: uppercase;
        color: var(--accent-color);
        margin-bottom: 20px;
        display: block;
        font-weight: 600;
        animation: fadeInLeft 1s ease-out;
      }

      .hero-title {
        font-family: var(--font-heading);
        font-size: clamp(3rem, 10vw, 6.5rem);
        line-height: 0.9;
        margin-bottom: 40px;
        animation: fadeInLeft 1.2s ease-out;
      }

      .hero-title span {
        display: block;
        font-weight: 400;
      }

      .hero-cta-group {
        display: flex;
        gap: 20px;
        align-items: center;
        animation: fadeInLeft 1.4s ease-out;
      }

      .hero-btn-primary {
        padding: 18px 45px;
        background: var(--accent-color);
        color: var(--white);
        text-decoration: none;
        font-family: var(--font-heading);
        letter-spacing: 2px;
        font-size: 13px;
        border-radius: 4px;
        transition: all 0.4s cubic-bezier(0.16, 1, 0.3, 1);
        text-transform: uppercase;
      }

      .hero-btn-primary:hover {
        background: var(--white);
        color: var(--primary-color);
        transform: translateY(-5px);
        box-shadow: 0 10px 30px rgba(0, 0, 0, 0.3);
      }

      /* Section Headers */
      .section-header {
        text-align: center;
        margin-bottom: 3rem;
      }

      .section-title {
        font-family: var(--font-heading);
        font-size: 2.5rem;
        color: var(--primary-color);
        margin-bottom: 1rem;
      }

      .section-subtitle {
        color: var(--light-text);
        font-size: 1rem;
        letter-spacing: 1px;
      }

      /* Collections/Products */
      .collections-section {
        padding: 5rem 0;
        background-color: var(--white);
      }

      .collection-nav {
        display: flex;
        justify-content: center;
        gap: 2rem;
        margin-bottom: 3rem;
      }

      .collection-btn {
        background: none;
        border: none;
        font-family: var(--font-body);
        font-size: 0.9rem;
        font-weight: 500;
        color: var(--light-text);
        cursor: pointer;
        padding-bottom: 5px;
        border-bottom: 2px solid transparent;
        transition: all 0.3s ease;
        text-transform: uppercase;
        letter-spacing: 1px;
      }

      .collection-btn.active,
      .collection-btn:hover {
        color: var(--primary-color);
        border-color: var(--accent-color);
      }

      /* Brand Marquee */
      .brand-marquee {
        padding: 40px 0;
        background: #fcfcfc;
        border-bottom: 1px solid #f0f0f0;
        overflow: hidden;
        white-space: nowrap;
        position: relative;
      }

      .marquee-content {
        display: inline-block;
        animation: marquee 30s linear infinite;
      }

      .brand-logo {
        display: inline-block;
        margin: 0 50px;
        font-family: var(--font-heading);
        font-size: 24px;
        font-weight: 700;
        color: #ccc;
        letter-spacing: 4px;
        text-transform: uppercase;
        transition: color 0.3s;
      }

      .brand-logo:hover {
        color: var(--accent-color);
      }

      @keyframes marquee {
        0% {
          transform: translateX(0);
        }

        100% {
          transform: translateX(-50%);
        }
      }

      /* Sections General */
      .section-padding {
        padding: 120px 0;
      }

      .section-header {
        margin-bottom: 80px;
        text-align: center;
      }

      .section-tag {
        font-size: 13px;
        text-transform: uppercase;
        letter-spacing: 4px;
        color: var(--accent-color);
        font-weight: 700;
        margin-bottom: 15px;
        display: block;
      }

      .section-title {
        font-family: var(--font-heading);
        font-size: clamp(2rem, 5vw, 3rem);
        color: var(--primary-color);
        margin-bottom: 20px;
      }

      /* Product Grid & Cards - Newgen Style */
      .product-grid {
        display: grid;
        grid-template-columns: repeat(4, 1fr);
        gap: 30px;
      }

      .product-card {
        background: var(--white);
        border-radius: 12px;
        overflow: hidden;
        transition: all 0.5s cubic-bezier(0.16, 1, 0.3, 1);
        position: relative;
        padding-bottom: 20px;
        border: 1px solid transparent;
      }

      .product-card:hover {
        transform: translateY(-15px);
        box-shadow: var(--shadow-strong);
        border-color: #f0f0f0;
      }

      .product-image-container {
        position: relative;
        aspect-ratio: 1;
        background: #f9f9f9;
        margin: 15px;
        border-radius: 8px;
        overflow: hidden;
      }

      .product-img {
        width: 100%;
        height: 100%;
        object-fit: contain;
        padding: 20px;
        transition: transform 0.8s cubic-bezier(0.16, 1, 0.3, 1);
      }

      .product-card:hover .product-img {
        transform: scale(1.15);
      }

      .quick-actions {
        position: absolute;
        bottom: 15px;
        left: 50%;
        transform: translateX(-50%) translateY(20px);
        display: flex;
        gap: 10px;
        opacity: 0;
        transition: all 0.4s cubic-bezier(0.16, 1, 0.3, 1);
      }

      .product-card:hover .quick-actions {
        opacity: 1;
        transform: translateX(-50%) translateY(0);
      }

      .action-btn {
        width: 45px;
        height: 45px;
        background: var(--white);
        border-radius: 50%;
        display: flex;
        align-items: center;
        justify-content: center;
        box-shadow: 0 5px 15px rgba(0, 0, 0, 0.1);
        color: var(--primary-color);
        transition: all 0.3s;
        cursor: pointer;
      }

      .action-btn:hover {
        background: var(--accent-color);
        color: var(--white);
        transform: scale(1.1);
      }

      .product-label {
        position: absolute;
        top: 15px;
        left: 15px;
        padding: 5px 12px;
        font-size: 10px;
        font-weight: 800;
        text-transform: uppercase;
        letter-spacing: 1px;
        border-radius: 4px;
        z-index: 5;
      }

      .label-new {
        background: var(--primary-color);
        color: var(--white);
      }

      .label-sale {
        background: #e74c3c;
        color: var(--white);
      }

      .product-details {
        padding: 0 20px;
        text-align: center;
      }

      .product-brand {
        font-size: 11px;
        text-transform: uppercase;
        letter-spacing: 2px;
        color: var(--light-text);
        margin-bottom: 5px;
        display: block;
      }

      .product-name {
        font-family: var(--font-body);
        font-size: 15px;
        font-weight: 500;
        margin-bottom: 10px;
        color: var(--primary-color);
      }

      .product-price-box {
        display: flex;
        justify-content: center;
        align-items: center;
        gap: 10px;
      }

      .price-now {
        font-weight: 700;
        color: var(--primary-color);
        font-size: 16px;
      }

      .price-old {
        color: #bbb;
        text-decoration: line-through;
        font-size: 14px;
      }

      /* Features Section */
      .features-section {
        padding: 6rem 0;
        background-color: #ffffff;
        position: relative;
      }

      .features-grid {
        display: grid;
        grid-template-columns: repeat(auto-fit, minmax(300px, 1fr));
        gap: 20px;
        text-align: center;
      }

      .feature-item {
        padding: 40px 30px;
        border-radius: 30px;
        transition: all 0.4s ease;
        background: var(--secondary-color);
        border: 1px solid transparent;
      }

      .feature-item:hover {
        background: var(--white);
        border-color: #f0f0f0;
        box-shadow: 0 20px 40px rgba(0, 0, 0, 0.05);
        transform: translateY(-5px);
      }

      .feature-icon {
        font-size: 2.2rem;
        color: var(--accent-color);
        margin-bottom: 25px;
        display: inline-block;
      }

      .feature-title {
        font-family: var(--font-heading);
        font-size: 1.3rem;
        margin-bottom: 15px;
        color: var(--primary-color);
        font-weight: 500;
        letter-spacing: 1px;
      }

      .feature-desc {
        font-size: 0.95rem;
        color: var(--light-text);
        line-height: 1.7;
      }

      /* Newsletter */
      .newsletter-section {
        padding: 8rem 0;
        background: linear-gradient(rgba(15, 17, 17, 0.95), rgba(15, 17, 17, 0.95)), url('/images/banner-bg.jpg') center/cover fixed;
        color: var(--white);
        text-align: center;
      }

      .newsletter-form {
        max-width: 500px;
        margin: 2rem auto 0;
        display: flex;
      }

      .newsletter-input {
        flex: 1;
        padding: 15px;
        border: 1px solid rgba(255, 255, 255, 0.2);
        background: transparent;
        color: var(--white);
        font-family: var(--font-body);
        outline: none;
        border-radius: 30px 0 0 30px;
        padding-left: 25px;
      }

      .newsletter-input::placeholder {
        color: rgba(255, 255, 255, 0.5);
      }

      .newsletter-btn {
        padding: 15px 30px;
        background-color: var(--accent-color);
        border: 1px solid var(--accent-color);
        color: var(--white);
        font-family: var(--font-heading);
        cursor: pointer;
        transition: all 0.3s ease;
        letter-spacing: 1px;
        border-radius: 0 30px 30px 0;
      }

      .newsletter-btn:hover {
        background-color: var(--white);
        color: var(--primary-color);
        border-color: var(--white);
      }

      .banner-carousel {
        position: relative;
        width: 100%;
        height: 92vh;
        overflow: hidden;
        background-color: var(--primary-color);
      }

      .banner-carousel::after {
        content: '';
        position: absolute;
        bottom: 0;
        left: 0;
        width: 100%;
        height: 20vh;
        background: linear-gradient(to top, var(--white), transparent);
        z-index: 2;
        pointer-events: none;
      }

      .banner-slide {
        position: absolute;
        top: 0;
        left: 0;
        width: 100%;
        height: 100%;
        opacity: 0;
        transition: opacity 1s ease-in-out;
        display: flex;
        align-items: center;
        justify-content: center;
      }

      .banner-slide.active {
        opacity: 1;
        z-index: 1;
      }

      .banner-image {
        width: 100%;
        height: 100%;
        object-fit: cover;
        filter: brightness(0.7);
      }

      .banner-content {
        position: absolute;
        top: 50%;
        left: 50%;
        transform: translate(-50%, -50%);
        text-align: center;
        color: var(--white);
        z-index: 2;
        max-width: 800px;
        padding: 0 20px;
      }

      .banner-title {
        font-family: var(--font-heading);
        font-size: clamp(2rem, 6vw, 4rem);
        margin-bottom: 1.5rem;
        text-shadow: 0 10px 30px rgba(0, 0, 0, 0.3);
        font-weight: 500;
      }

      .banner-description {
        font-size: 1.1rem;
        margin-bottom: 2.5rem;
        color: rgba(255, 255, 255, 0.9);
        letter-spacing: 1px;
        line-height: 1.6;
      }

      .banner-btn {
        display: inline-block;
        padding: 15px 40px;
        background-color: var(--accent-color);
        border: 1px solid var(--accent-color);
        color: var(--white);
        text-decoration: none;
        font-family: var(--font-heading);
        text-transform: uppercase;
        letter-spacing: 2px;
        transition: all 0.3s ease;
        font-size: 0.9rem;
        animation: fadeInUp 1s ease-out 0.4s both;
        border-radius: 30px;
      }

      .banner-btn:hover {
        background-color: transparent;
        border-color: var(--white);
        color: var(--white);
      }

      .carousel-controls {
        position: absolute;
        bottom: 30px;
        left: 50%;
        transform: translateX(-50%);
        display: flex;
        gap: 10px;
        z-index: 3;
      }

      .carousel-dot {
        width: 12px;
        height: 12px;
        border-radius: 50%;
        background-color: rgba(255, 255, 255, 0.5);
        border: none;
        cursor: pointer;
        transition: all 0.3s ease;
      }

      .carousel-dot.active {
        background-color: var(--accent-color);
        transform: scale(1.2);
      }

      .carousel-arrow {
        position: absolute;
        top: 50%;
        transform: translateY(-50%);
        background-color: rgba(255, 255, 255, 0.2);
        border: 1px solid rgba(255, 255, 255, 0.5);
        color: var(--white);
        width: 50px;
        height: 50px;
        border-radius: 50%;
        cursor: pointer;
        transition: all 0.3s ease;
        z-index: 3;
        display: flex;
        align-items: center;
        justify-content: center;
        font-size: 1.2rem;
      }

      .carousel-arrow:hover {
        background-color: var(--accent-color);
        border-color: var(--accent-color);
      }

      .carousel-arrow.prev {
        left: 30px;
      }

      .carousel-arrow.next {
        right: 30px;
      }

      /* Animation helper */
      @keyframes premiumFadeInUp {
        0% {
          opacity: 0;
          transform: translateY(40px) scale(0.98);
        }

        100% {
          opacity: 1;
          transform: translateY(0) scale(1);
        }
      }

      @keyframes glass-shine {
        0% {
          left: -100%;
        }

        100% {
          left: 100%;
        }
      }

      @keyframes fadeInUp {
        from {
          opacity: 0;
          transform: translateY(20px);
        }

        to {
          opacity: 1;
          transform: translateY(0);
        }
      }

      /* Mobile Adjustments */
      @media (max-width: 768px) {
        .banner-carousel {
          height: 50vh;
        }

        .banner-title {
          font-size: 2rem;
        }

        .banner-description {
          font-size: 1rem;
        }

        .carousel-arrow {
          width: 40px;
          height: 40px;
          font-size: 1rem;
        }

        .carousel-arrow.prev {
          left: 15px;
        }

        .carousel-arrow.next {
          right: 15px;
        }

        .hero-title {
          font-size: 3.5rem;
        }

        .product-grid {
          grid-template-columns: repeat(2, 1fr);
          gap: 15px;
        }

        .newsletter-form {
          flex-direction: column;
          gap: 10px;
        }

        .hero-content {
          padding-left: 5%;
          text-align: center;
        }

        .hero-cta-group {
          justify-content: center;
        }

        .section-padding {
          padding: 60px 0;
        }
      }
    </style>
  </head>

  <% if (banners && banners.length> 0) { %>
    <!-- Banner Carousel -->
    <section class="banner-carousel">
      <% banners.forEach((banner, index)=> { %>
        <div class="banner-slide <%= index === 0 ? 'active' : '' %>" data-index="<%= index %>">
          <img src="/uploads/banners/<%= banner.image %>" alt="<%= banner.title %>" class="banner-image"
            onerror="this.src='/images/banner-bg.jpg'">
          <div class="banner-content">
            <span class="hero-subtitle" data-aos="fade-down">EXCLUSIVE RELEASE</span>
            <h2 class="banner-title" data-aos="fade-up" data-aos-delay="200">
              <%= banner.title %>
            </h2>
            <p class="banner-description" data-aos="fade-up" data-aos-delay="400">
              <%= banner.description %>
            </p>
            <div class="hero-cta-group" style="justify-content: center;" data-aos="fade-up" data-aos-delay="600">
              <% if (banner.link) { %>
                <a href="<%= banner.link %>" class="hero-btn-primary">Explore Piece</a>
                <% } %>
            </div>
          </div>
        </div>
        <% }); %>

          <% if (banners.length> 1) { %>
            <button class="carousel-arrow prev" onclick="changeBanner(-1)">
              <i class="fas fa-chevron-left"></i>
            </button>
            <button class="carousel-arrow next" onclick="changeBanner(1)">
              <i class="fas fa-chevron-right"></i>
            </button>

            <div class="carousel-controls">
              <% banners.forEach(function(banner, index) { %>
                <div class="carousel-dot <%= index === 0 ? 'active' : '' %>" data-target="<%= index %>"
                  onclick="goToBanner(this.getAttribute('data-target'))"></div>
                <% }); %>
            </div>
            <% } %>
    </section>
    <% } else { %>
      <!-- Newgen Hero Section -->
      <section class="hero-section">
        <video class="hero-video-bg" autoplay muted loop playsinline poster="/images/banner-bg.jpg">
          <source src="/images/watch-hero.mp4" type="video/mp4">
        </video>
        <div class="hero-content">
          <span class="hero-subtitle">Elevate Your Presence</span>
          <h1 class="hero-title">
            <span>TIMELESS</span>
            <span>MASTERPIECES</span>
          </h1>
          <div class="hero-cta-group">
            <a href="#collections" class="hero-btn-primary">Explore Catalog</a>
          </div>
        </div>
      </section>
      <% } %>

        <!-- Brand Marquee -->
        <section class="brand-marquee">
          <div class="marquee-content">
            <span class="brand-logo">Rolex</span>
            <span class="brand-logo">Omega</span>
            <span class="brand-logo">Patek Philippe</span>
            <span class="brand-logo">Audemars Piguet</span>
            <span class="brand-logo">Cartier</span>
            <span class="brand-logo">Tag Heuer</span>
            <span class="brand-logo">Rolex</span>
            <span class="brand-logo">Omega</span>
            <span class="brand-logo">Patek Philippe</span>
            <span class="brand-logo">Audemars Piguet</span>
            <span class="brand-logo">Cartier</span>
            <span class="brand-logo">Tag Heuer</span>
          </div>
        </section>



        <!-- Collections Section -->
        <section id="collections" class="section-padding">
          <div class="container">
            <div class="section-header" data-aos="fade-up">
              <span class="section-tag">Elite Curation</span>
              <h2 class="section-title">THE COLLECTION</h2>
              <div class="collection-nav" id="collectionNav">
                <button class="collection-btn active" data-filter="all">All Pieces</button>
              </div>
            </div>

            <div class="product-grid">
              <% if (products && products.length> 0) { %>
                <% products.slice(0, 8).forEach((product, index)=> { %>
                  <div class="product-card" data-aos="fade-up" data-aos-delay="<%= index * 100 %>">
                    <% if(index < 4) { %>
                      <span class="product-label label-new">Limited</span>
                      <% } %>
                        <div class="product-image-container">
                          <a href="/productDetails?id=<%= product._id %>">
                            <img src="/uploads/re-image/<%= product.productImage[0] %>" alt="<%= product.productName %>"
                              class="product-img" onerror="this.src='/images/pexels-brett-sayles-1186851.jpg'">
                          </a>
                          <div class="quick-actions">
                            <div class="action-btn" onclick="addToWishlist(event, '<%= product._id %>')"
                              title="Add to Wishlist">
                              <i class="far fa-heart"></i>
                            </div>
                            <div class="action-btn" onclick="addToCart(event, '<%= product._id %>')"
                              title="Add to Cart">
                              <i class="fas fa-shopping-bag"></i>
                            </div>
                          </div>
                        </div>
                        <div class="product-details">
                          <span class="product-brand">
                            <%= product.brand ? product.brand.brandName : 'Luxury Edition' %>
                          </span>
                          <h3 class="product-name">
                            <%= product.productName %>
                          </h3>
                          <div class="product-price-box">
                            <% const offer=Math.max(product.productOffer || 0, product.category?.categoryOffer || 0); if
                              (offer> 0) {
                              const discountedPrice = Math.round(product.salesPrice - (product.salesPrice * offer /
                              100));
                              %>
                              <span class="price-now">₹<%= discountedPrice.toLocaleString() %></span>
                              <span class="price-old">₹<%= product.salesPrice.toLocaleString() %></span>
                              <% } else { %>
                                <span class="price-now">₹<%= product.salesPrice.toLocaleString() %></span>
                                <% } %>
                          </div>
                        </div>
                  </div>
                  <% }); %>
                    <% } else { %>
                      <div class="col-12 text-center py-5">
                        <h3 class="text-muted">Awaiting The Next Drop</h3>
                      </div>
                      <% } %>
            </div>

            <div class="text-center mt-5" data-aos="fade-up">
              <a href="/shop" class="hero-btn-primary"
                style="background: transparent; color: var(--primary-color); border: 1px solid #ddd; padding: 15px 60px;">View
                Full House</a>
            </div>
          </div>
        </section>

        <!-- Features Section -->
        <section class="features-section">
          <div class="container">
            <div class="features-grid">
              <div class="feature-item" data-aos="fade-up" data-aos-delay="100">
                <i class="fas fa-shipping-fast feature-icon"></i>
                <h3 class="feature-title">Global Concierge</h3>
                <p class="feature-desc">Priority white-glove delivery on all premium orders across the globe.</p>
              </div>
              <div class="feature-item" data-aos="fade-up" data-aos-delay="200">
                <i class="fas fa-certificate feature-icon"></i>
                <h3 class="feature-title">Heritage Verified</h3>
                <p class="feature-desc">Each timepiece undergoes rigorous certification for 100% original provenance.
                </p>
              </div>
              <div class="feature-item" data-aos="fade-up" data-aos-delay="300">
                <i class="fas fa-shield-alt feature-icon"></i>
                <h3 class="feature-title">Extended Legacy</h3>
                <p class="feature-desc">Comprehensive 5-year international coverage on all our technical complications.
                </p>
              </div>
            </div>
          </div>
        </section>

        <!-- Newsletter Section -->
        <section class="newsletter-section">
          <div class="container">
            <h2 class="section-title" style="color: var(--white);">Join The Elite</h2>
            <p class="section-subtitle" style="color: rgba(255,255,255,0.7);">Subscribe for early access to
              limited
              releases.
            </p>
            <form class="newsletter-form"
              onsubmit="event.preventDefault(); Swal.fire('Subscribed!', 'Welcome to the club.', 'success');">
              <input type="email" class="newsletter-input" placeholder="Your email address" required>
              <button type="submit" class="newsletter-btn">SUBSCRIBE</button>
