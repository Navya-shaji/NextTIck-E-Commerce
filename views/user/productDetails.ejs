<%- include('../partials/user/header') %>

    <style>
        :root {
            --primary-color: #0f1111;
            --secondary-color: #f7f8f8;
            --accent-color: #d4af37;
            /* Metallic Gold */
            --accent-light: #f1e5ac;
            --text-color: #1a1a1a;
            --light-text: #757575;
            --white: #ffffff;
            --border-color: #f0f0f0;
            --success-color: #2ecc71;
            --danger-color: #e74c3c;
            --font-heading: 'Cinzel', serif;
            --font-body: 'Outfit', sans-serif;
            --glass-bg: rgba(255, 255, 255, 0.85);
        }

        body {
            font-family: var(--font-body);
            color: var(--text-color);
            background-color: #fff;
        }

        /* Breadcrumbs */
        .breadcrumb-area {
            background: transparent;
            padding: 20px 0;
            margin-bottom: 20px;
        }

        .breadcrumb {
            background: transparent;
            padding: 0;
            margin: 0;
            font-size: 0.9rem;
            color: var(--light-text);
        }

        .breadcrumb-item a {
            color: var(--light-text);
            text-decoration: none;
            transition: color 0.3s;
        }

        .breadcrumb-item a:hover {
            color: var(--accent-color);
        }

        .breadcrumb-item.active {
            color: var(--primary-color);
            font-weight: 500;
        }

        .breadcrumb-item+.breadcrumb-item::before {
            content: "›";
            color: var(--light-text);
        }

        /* Product Layout */
        .product-detail-container {
            padding: 0 0 80px 0;
        }

        .image-gallery {
            position: sticky;
            top: 100px;
        }

        .main-image-wrapper {
            position: relative;
            background: #f8f8f8;
            border-radius: 0;
            overflow: hidden;
            margin-bottom: 20px;
            aspect-ratio: 1;
            cursor: crosshair;
        }

        .main-image {
            width: 100%;
            height: 100%;
            object-fit: cover;
            transition: transform 0.3s ease;
        }

        .thumbnails-wrapper {
            display: flex;
            gap: 15px;
            overflow-x: auto;
            padding-bottom: 5px;
        }

        .thumbnail {
            width: 80px;
            height: 80px;
            object-fit: cover;
            cursor: pointer;
            border: 1px solid transparent;
            opacity: 0.7;
            transition: all 0.3s;
        }

        .thumbnail:hover,
        .thumbnail.active {
            border-color: var(--accent-color);
            opacity: 1;
        }

        /* Product Info */
        .product-info-wrapper {
            padding-left: 40px;
        }

        .product-title {
            font-family: var(--font-heading);
            font-size: clamp(2rem, 5vw, 3.2rem);
            font-weight: 500;
            margin-bottom: 15px;
            color: var(--primary-color);
            line-height: 1.1;
            letter-spacing: -1px;
        }

        .product-meta {
            display: flex;
            align-items: center;
            gap: 20px;
            margin-bottom: 20px;
            font-size: 0.9rem;
            color: var(--light-text);
        }

        .rating {
            color: var(--accent-color);
        }

        .price-wrapper {
            margin-bottom: 25px;
            display: flex;
            align-items: baseline;
            gap: 15px;
            flex-wrap: wrap;
        }

        .current-price {
            font-size: 2.2rem;
            font-weight: 600;
            color: var(--primary-color);
            font-family: var(--font-body);
            letter-spacing: -1px;
        }

        .original-price {
            font-size: 1.3rem;
            color: var(--light-text);
            text-decoration: line-through;
            opacity: 0.6;
        }

        .discount-tag {
            background-color: var(--accent-color);
            color: var(--primary-color);
            padding: 5px 12px;
            font-size: 0.75rem;
            font-weight: 800;
            text-transform: uppercase;
            letter-spacing: 1.5px;
            border-radius: 4px;
        }

        .best-offer-info {
            background: #fdfdfd;
            border: 1px dashed var(--accent-color);
            padding: 10px 15px;
            margin-bottom: 25px;
            font-size: 0.9rem;
            color: var(--text-color);
        }

        .description-wrapper {
            margin-bottom: 30px;
            line-height: 1.8;
            color: var(--light-text);
            border-top: 1px solid var(--border-color);
            padding-top: 20px;
        }

        .stock-status-wrapper {
            margin-bottom: 25px;
        }

        .stock-badge {
            display: inline-flex;
            align-items: center;
            gap: 6px;
            font-weight: 500;
            font-size: 0.9rem;
        }

        .stock-badge.in-stock {
            color: var(--success-color);
        }

        .stock-badge.low-stock {
            color: #e67e22;
        }

        .stock-badge.out-stock {
            color: var(--danger-color);
        }

        /* Controls */
        .controls-wrapper {
            display: flex;
            gap: 20px;
            margin-bottom: 30px;
            align-items: center;
            flex-wrap: wrap;
        }

        .quantity-wrapper {
            display: flex;
            align-items: center;
            border: 1px solid var(--border-color);
            height: 50px;
        }

        .qty-btn {
            width: 40px;
            height: 100%;
            border: none;
            background: transparent;
            font-size: 1.2rem;
            cursor: pointer;
            color: var(--primary-color);
            transition: background 0.2s;
        }

        .qty-btn:hover:not(:disabled) {
            background: #f5f5f5;
        }

        .qty-input {
            width: 50px;
            height: 100%;
            border: none;
            text-align: center;
            font-family: var(--font-body);
            font-weight: 600;
            font-size: 1rem;
            color: var(--primary-color);
            -moz-appearance: textfield;
            appearance: textfield;
        }

        .qty-input::-webkit-outer-spin-button,
        .qty-input::-webkit-inner-spin-button {
            -webkit-appearance: none;
            margin: 0;
        }

        .btn-add-cart {
            background-color: var(--primary-color);
            color: var(--white);
            height: 60px;
            padding: 0 50px;
            font-family: var(--font-heading);
            text-transform: uppercase;
            letter-spacing: 2px;
            font-weight: 600;
            border: none;
            cursor: pointer;
            transition: all 0.4s cubic-bezier(0.16, 1, 0.3, 1);
            flex: 1;
            max-width: 320px;
            border-radius: 4px;
            position: relative;
            overflow: hidden;
        }

        .btn-add-cart::after {
            content: '';
            position: absolute;
            top: 0;
            left: -100%;
            width: 100%;
            height: 100%;
            background: linear-gradient(90deg, transparent, rgba(255, 255, 255, 0.1), transparent);
            transition: 0.5s;
        }

        .btn-add-cart:hover::after {
            left: 100%;
        }

        .btn-add-cart:hover:not(:disabled) {
            background-color: #222;
            transform: translateY(-2px);
            box-shadow: 0 10px 20px rgba(0, 0, 0, 0.1);
        }

        .btn-add-cart:disabled {
            background-color: #eee;
            color: #999;
            cursor: not-allowed;
        }

        .btn-wishlist {
            width: 60px;
            height: 60px;
            border: 1px solid var(--border-color);
            background: var(--white);
            color: var(--primary-color);
            cursor: pointer;
            transition: all 0.3s;
            display: flex;
            align-items: center;
            justify-content: center;
            font-size: 1.3rem;
            border-radius: 4px;
        }

        .btn-wishlist:hover {
            border-color: var(--accent-color);
            color: var(--accent-color);
            transform: translateY(-2px);
            box-shadow: 0 5px 15px rgba(0, 0, 0, 0.05);
        }

        /* Related Products */
        .related-section {
            margin-top: 80px;
            padding-top: 60px;
            border-top: 1px solid var(--border-color);
        }

        .section-heading {
            font-family: var(--font-heading);
            font-size: 1.8rem;
            text-align: center;
            margin-bottom: 50px;
            text-transform: uppercase;
            letter-spacing: 3px;
            color: var(--primary-color);
        }

        .premium-product-card {
            background: var(--white);
            transition: all 0.4s cubic-bezier(0.16, 1, 0.3, 1);
            position: relative;
            padding: 15px;
            border-radius: 24px;
            border: 1px solid transparent;
        }

        .premium-product-card:hover {
            transform: translateY(-10px);
            border-color: var(--border-color);
            box-shadow: 0 20px 40px rgba(0, 0, 0, 0.08);
        }

        .premium-image-wrapper {
            position: relative;
            background: #fcfcfc;
            aspect-ratio: 1;
            overflow: hidden;
            border-radius: 20px;
            margin-bottom: 20px;
        }

        .premium-card-img {
            width: 100%;
            height: 100%;
            object-fit: contain;
            padding: 15px;
            transition: transform 0.8s cubic-bezier(0.16, 1, 0.3, 1);
        }

        .premium-product-card:hover .premium-card-img {
            transform: scale(1.1);
        }

        .premium-card-info {
            text-align: center;
        }

        .premium-card-title {
            font-family: var(--font-body);
            font-size: 0.95rem;
            font-weight: 500;
            margin-bottom: 6px;
            color: var(--primary-color);
            display: -webkit-box;
            -webkit-line-clamp: 1;
            line-clamp: 1;
            -webkit-box-orient: vertical;
            overflow: hidden;
        }

        .premium-card-price {
            font-weight: 600;
            color: var(--accent-color);
            font-size: 1.1rem;
        }

        /* Review Styles */
        .reviews-section {
            margin-top: 80px;
            padding-top: 60px;
            border-top: 1px solid #eee;
        }

        .avg-rating-box {
            background: var(--white);
            padding: 40px;
            text-align: center;
            border-radius: 24px;
            border: 1px solid var(--border-color);
            box-shadow: 0 10px 30px rgba(0, 0, 0, 0.02);
            height: 100%;
            display: flex;
            flex-direction: column;
            justify-content: center;
        }

        .rating-distribution {
            margin-top: 25px;
            text-align: left;
        }

        .dist-row {
            display: flex;
            align-items: center;
            gap: 12px;
            margin-bottom: 8px;
            font-size: 0.85rem;
            color: var(--light-text);
        }

        .dist-bar-bg {
            flex: 1;
            height: 6px;
            background: #f0f0f0;
            border-radius: 10px;
            overflow: hidden;
        }

        .dist-bar-fill {
            height: 100%;
            background: var(--accent-color);
            border-radius: 10px;
        }

        .dist-count {
            width: 30px;
            text-align: right;
            font-weight: 500;
        }

        .review-card {
            padding: 35px;
            background: var(--white);
            border: 1px solid var(--border-color);
            border-radius: 20px;
            margin-bottom: 25px;
            transition: all 0.4s cubic-bezier(0.16, 1, 0.3, 1);
        }

        .review-card:hover {
            transform: translateY(-5px);
            border-color: var(--accent-color);
            box-shadow: 0 15px 40px rgba(0, 0, 0, 0.05);
        }

        .reviewer-avatar {
            width: 45px;
            height: 45px;
            background: var(--secondary-color);
            border-radius: 50%;
            display: flex;
            align-items: center;
            justify-content: center;
            color: var(--accent-color);
            font-weight: 700;
            font-size: 1.1rem;
        }

        .review-header-top {
            display: flex;
            align-items: center;
            gap: 15px;
            margin-bottom: 15px;
        }

        .reviewer-info {
            flex: 1;
        }

        .review-hint {
            font-size: 0.85rem;
            color: var(--light-text);
            padding: 15px 20px;
            background: #fafafa;
            border-radius: 12px;
            border-left: 3px solid var(--accent-color);
            margin-bottom: 40px;
        }

        .avg-number {
            font-size: 3rem;
            font-weight: 700;
            color: var(--primary-color);
            display: block;
        }

        /* Magnifier */
        .magnifying-glass {
            position: absolute;
            border-radius: 50%;
            border: 1px solid rgba(255, 255, 255, 0.5);
            cursor: none;
            width: 200px;
            height: 200px;
            display: none;
            pointer-events: none;
            box-shadow: 0 15px 45px rgba(0, 0, 0, 0.3), inset 0 0 20px rgba(255, 255, 255, 0.2);
            z-index: 100;
            background-color: var(--white);
            background-repeat: no-repeat;
            transition: opacity 0.2s ease;
        }

        /* Entrance Animations */
        [data-aos] {
            pointer-events: none;
        }

        .aos-animate {
            pointer-events: auto;
        }

        @media (max-width: 768px) {
            .product-detail-container {
                padding-bottom: 100px;
            }

            .product-info-wrapper {
                padding-left: 0;
                margin-top: 30px;
            }

            .controls-wrapper {
                position: fixed;
                bottom: 0;
                left: 0;
                right: 0;
                background: var(--white);
                padding: 15px 25px;
                box-shadow: 0 -10px 30px rgba(0, 0, 0, 0.08);
                margin: 0;
                z-index: 1000;
                display: flex;
                gap: 15px;
                backdrop-filter: blur(10px);
            }

            .btn-add-cart {
                height: 50px;
                font-size: 0.9rem;
            }

            .btn-wishlist {
                height: 50px;
                width: 50px;
            }
        }
    </style>

    <div class="container my-4">
        <!-- Breadcrumb -->
        <div class="breadcrumb-area">
            <nav aria-label="breadcrumb">
                <ol class="breadcrumb">
                    <li class="breadcrumb-item"><a href="/">Home</a></li>
                    <li class="breadcrumb-item"><a href="/shop">Shop</a></li>
                    <% if (product.category) { %>
                        <li class="breadcrumb-item"><a href="/shop?category=<%= product.category._id %>">
                                <%= product.category.name %>
                            </a></li>
                        <% } %>
                            <li class="breadcrumb-item active" aria-current="page">
                                <%= product.productName %>
                            </li>
                </ol>
            </nav>
        </div>

        <!-- Main Content -->
        <div class="row product-detail-container">
            <!-- Gallery -->
            <div class="col-lg-6 mb-4">
                <div class="image-gallery">
                    <div class="main-image-wrapper" id="imageContainer" onmousemove="magnify(event)"
                        onmouseleave="removeMagnify()">
                        <img src="/uploads/re-image/<%= product.productImage[0] %>" alt="<%= product.productName %>"
                            class="main-image" id="mainImage"
                            onerror="this.src='/images/pexels-brett-sayles-1186851.jpg'">
                        <div class="magnifying-glass" id="magnifyingGlass"></div>
                    </div>

                    <% if (product.productImage.length> 1) { %>
                        <div class="thumbnails-wrapper">
                            <% product.productImage.forEach((image, index)=> { %>
                                <img src="/uploads/re-image/<%= image %>" alt="Thumbnail <%= index + 1 %>"
                                    class="thumbnail <%= index === 0 ? 'active' : '' %>"
                                    onclick="changeImage('/uploads/re-image/<%= image %>', this)">
                                <% }); %>
                        </div>
                        <% } %>
                </div>
            </div>

            <!-- Details -->
            <div class="col-lg-6" data-aos="fade-left">
                <div class="product-info-wrapper">
                    <div class="product-meta">
                        <% if (product.category) { %>
                            <span class="text-uppercase fw-600" style="letter-spacing: 2px;">
                                <%= product.category.name %>
                            </span>
                            <% } %>
                                <span class="stock-badge <%= product.quantity > 0 ? 'in-stock' : 'out-stock' %>">
                                    <i
                                        class="fas <%= product.quantity > 0 ? 'fa-check-circle' : 'fa-times-circle' %>"></i>
                                    <%= product.quantity> 0 ? 'In Stock' : 'Out of Stock' %>
                                </span>
                    </div>

                    <h1 class="product-title">
                        <%= product.productName %>
                    </h1>

                    <!-- Price Logic -->
                    <div class="price-wrapper">
                        <% const productOffer=product.productOffer || 0; const categoryOffer=category?.categoryOffer ||
                            0; const bestOffer=totalOffer || Math.max(productOffer, categoryOffer); const
                            regularPrice=product.salesPrice || 0; const discountAmount=regularPrice * (bestOffer / 100);
                            const salesPrice=regularPrice - discountAmount; %>

                            <span class="current-price">₹<%= salesPrice.toLocaleString('en-IN', {minimumFractionDigits:
                                    2}) %></span>
                            <% if (bestOffer> 0) { %>
                                <span class="original-price">₹<%= regularPrice.toLocaleString('en-IN',
                                        {minimumFractionDigits: 2}) %></span>
                                <span class="discount-tag">
                                    <%= bestOffer %>% OFF
                                </span>
                                <% } %>
                    </div>

                    <% if (bestOffer> 0) { %>
                        <div class="best-offer-info">
                            <i class="fas fa-gem me-2" style="color: var(--accent-color);"></i>
                            <% if (productOffer> categoryOffer) { %>
                                Exclusive Product Privilege Applied
                                <% } else { %>
                                    Seasonal Category Benefit Applied
                                    <% } %>
                        </div>
                        <% } %>

                            <div class="description-wrapper">
                                <p class="mb-0">
                                    <%= product.description %>
                                </p>
                            </div>

                            <% if (product.quantity> 0) { %>
                                <div class="controls-wrapper">
                                    <button onclick="addToCart('<%= product._id %>')" class="btn-add-cart">Add to
                                        Bag</button>

                                    <button onclick="addToWishlist('<%= product._id %>')" class="btn-wishlist"
                                        title="Add to Wishlist">
                                        <i class="far fa-heart"></i>
                                    </button>
                                </div>
                                <% } else { %>
                                    <div class="alert alert-soft-dark d-flex align-items-center mb-4"
                                        style="background: var(--secondary-color); border: none; border-radius: 12px; padding: 20px;">
                                        <i class="fas fa-envelope-open-text me-3 opacity-50"></i>
                                        <div>
                                            <div class="fw-bold">Currently Unavailable</div>
                                            <div class="small opacity-75">We can notify you when this masterpiece
                                                returns to our collection.</div>
                                        </div>
                                    </div>
                                    <% } %>

                                        <!-- Additional Info -->
                                        <div class="accordion accordion-flush mt-5" id="productAccordion">
                                            <div class="accordion-item"
                                                style="border-top: 1px solid var(--border-color);">
                                                <h2 class="accordion-header">
                                                    <button class="accordion-button collapsed fw-500" type="button"
                                                        data-bs-toggle="collapse" data-bs-target="#specifications"
                                                        style="font-family: var(--font-heading); letter-spacing: 2px; font-size: 11px;">
                                                        SPECIFICATIONS
                                                    </button>
                                                </h2>
                                                <div id="specifications" class="accordion-collapse collapse"
                                                    data-bs-parent="#productAccordion">
                                                    <div class="accordion-body text-muted small px-0">
                                                        <div class="d-flex justify-content-between mb-3">
                                                            <span>Brand</span>
                                                            <span class="text-dark fw-600">
                                                                <%= product.brand ? product.brand.brandName : 'Luxury'
                                                                    %>
                                                            </span>
                                                        </div>
                                                        <div class="d-flex justify-content-between mb-3">
                                                            <span>Collection</span>
                                                            <span class="text-dark fw-600">
                                                                <%= product.category ? product.category.name
                                                                    : 'Exquisite' %>
                                                            </span>
                                                        </div>
                                                        <% if (product.color) { %>
                                                            <div class="d-flex justify-content-between mb-3">
                                                                <span>Finishing</span>
                                                                <span class="text-dark fw-600">
                                                                    <%= product.color %>
                                                                </span>
                                                            </div>
                                                            <% } %>
                                                                <div class="d-flex justify-content-between">
                                                                    <span>Authenticity</span>
                                                                    <span class="text-dark fw-600">Heritage
                                                                        Certified</span>
                                                                </div>
                                                    </div>
                                                </div>
                                            </div>
                                        </div>
                </div>
            </div>
        </div>

        <!-- Reviews Section -->
        <div class="reviews-section" id="reviews">
            <div class="row mb-5 align-items-center" data-aos="fade-up">
                <div class="col-md-6">
                    <h2 class="section-heading mb-0" style="text-align: left;">Customer Reviews</h2>
                </div>
                <div class="col-md-6 text-md-end">
                    <span class="text-muted fw-500">
                        <%= reviews.length %> Authenticated Reviews
                    </span>
                </div>
            </div>

            <div class="review-hint" data-aos="fade-up">
                <i class="fas fa-info-circle me-2"></i>
                To maintain authenticity, reviews can only be submitted by owners of this timepiece via their <a
                    href="/userProfile" class="text-dark fw-bold">Order History</a> after delivery.
            </div>

            <div class="row">
                <% if (reviews && reviews.length> 0) { %>
                    <div class="col-lg-4 mb-5" data-aos="fade-right">
                        <div class="avg-rating-box">
                            <% let totalRating=reviews.reduce((acc, curr)=> acc + curr.rating, 0);
                                let avg = (totalRating / reviews.length).toFixed(1);
                                let distribution = [0, 0, 0, 0, 0];
                                reviews.forEach(r => { if(r.rating >= 1 && r.rating <= 5) distribution[r.rating - 1]++;
                                    }); %>
                                    <span class="avg-number">
                                        <%= avg %>
                                    </span>
                                    <div class="review-stars mb-2" style="color: var(--accent-color);">
                                        <% for(let i=1; i<=5; i++) { %>
                                            <i class="<%= i <= Math.round(avg) ? 'fas' : 'far' %> fa-star"></i>
                                            <% } %>
                                    </div>
                                    <p class="text-muted small mb-0">Based on <%= reviews.length %> verified ratings</p>

                                    <div class="rating-distribution">
                                        <% for(let i=5; i>=1; i--) {
                                            let count = distribution[i-1];
                                            let percentage = (count / reviews.length * 100).toFixed(0);
                                            %>
                                            <div class="dist-row">
                                                <span>
                                                    <%= i %> <i class="fas fa-star" style="font-size: 0.7rem;"></i>
                                                </span>
                                                <div class="dist-bar-bg">
                                                    <div class="dist-bar-fill" style="width: <%= percentage %>%;"></div>
                                                </div>
                                                <span class="dist-count">
                                                    <%= count %>
                                                </span>
                                            </div>
                                            <% } %>
                                    </div>
                        </div>
                    </div>
                    <div class="col-lg-8">
                        <% reviews.forEach((review, index)=> { %>
                            <div class="review-card" data-aos="fade-up" data-aos-delay="<%= 100 * (index % 3) %>">
                                <div class="review-header-top">
                                    <div class="reviewer-avatar">
                                        <%= review.userName.charAt(0).toUpperCase() %>
                                    </div>
                                    <div class="reviewer-info">
                                        <div class="reviewer-name">
                                            <%= review.userName %>
                                        </div>
                                        <div class="review-stars"
                                            style="color: var(--accent-color); font-size: 0.75rem;">
                                            <% for(let i=1; i<=5; i++) { %>
                                                <i class="<%= i <= review.rating ? 'fas' : 'far' %> fa-star"></i>
                                                <% } %>
                                        </div>
                                    </div>
                                    <span class="review-date">
                                        <%= new Date(review.createdOn).toLocaleDateString('en-GB') %>
                                    </span>
                                </div>
                                <p class="review-comment">
                                    <%= review.comment %>
                                </p>
                            </div>
                            <% }); %>
                    </div>
                    <% } else { %>
                        <div class="col-12 text-center py-5" data-aos="zoom-in">
                            <div class="text-muted mb-4">
                                <i class="fas fa-award fa-4x opacity-25" style="color: var(--accent-color);"></i>
                            </div>
                            <h4 class="font-heading" style="color: var(--primary-color);">Be the First to Review</h4>
                            <p class="text-muted mx-auto" style="max-width: 400px;">Share your experience with this
                                exclusive timepiece. Reviews are exclusive to verified purchasers.</p>
                            <a href="/shop" class="btn btn-outline-dark rounded-pill px-4 mt-3">Continue Exploring</a>
                        </div>
                        <% } %>
            </div>
        </div>

        <!-- Related Products -->
        <% if (relatedProducts && relatedProducts.length> 0) { %>
            <div class="related-section">
                <h2 class="section-heading">You May Also Like</h2>
                <div class="row">
                    <% relatedProducts.forEach(related=> { %>
                        <div class="col-md-3 col-6 mb-4">
                            <div class="premium-product-card">
                                <a href="/productDetails?id=<%= related._id %>" class="text-decoration-none">
                                    <div class="premium-image-wrapper">
                                        <img src="/uploads/re-image/<%= related.productImage[0] %>"
                                            alt="<%= related.productName %>" class="premium-card-img"
                                            onerror="this.src='/images/pexels-brett-sayles-1186851.jpg'">
                                    </div>
                                    <div class="premium-card-info">
                                        <h5 class="premium-card-title">
                                            <%= related.productName %>
                                        </h5>
                                        <div class="premium-card-price">₹<%= related.salesPrice.toLocaleString() %>
                                        </div>
                                    </div>
                                </a>
                            </div>
                        </div>
                        <% }); %>
                </div>
            </div>
            <% } %>
    </div>

    <!-- Scripts -->
    <script src="https://cdnjs.cloudflare.com/ajax/libs/jquery/3.6.0/jquery.min.js"></script>
    <script src="https://cdn.jsdelivr.net/npm/sweetalert2@11"></script>

    <script>
        // Image Handling
        function changeImage(src, element) {
            document.getElementById('mainImage').src = src;
            document.querySelectorAll('.thumbnail').forEach(thumb => thumb.classList.remove('active'));
            element.classList.add('active');

            // Update magnifier bg
            const glass = document.getElementById('magnifyingGlass');
            glass.style.backgroundImage = "url('" + src + "')";
        }

        // Magnifier Logic - Improved Lens Effect
        function magnify(e) {
            if (window.innerWidth <= 768) return;

            const container = document.getElementById('imageContainer');
            const img = document.getElementById('mainImage');
            const glass = document.getElementById('magnifyingGlass');

            // Show glass
            glass.style.display = 'block';

            // Get standard dimensions
            const rect = container.getBoundingClientRect();

            // Get cursor position relative to image container
            const x = e.clientX - rect.left;
            const y = e.clientY - rect.top;

            // Calculate ratios for background position (0% to 100%)
            let bgX = (x / rect.width) * 100;
            let bgY = (y / rect.height) * 100;

            // Clamp values
            bgX = Math.max(0, Math.min(100, bgX));
            bgY = Math.max(0, Math.min(100, bgY));

            // Calculate zoom properties
            const zoomLevel = 3;
            glass.style.backgroundImage = `url('${img.src}')`;
            glass.style.backgroundSize = `${rect.width * zoomLevel}px ${rect.height * zoomLevel}px`;
            glass.style.backgroundPosition = `${bgX}% ${bgY}%`;

            // Center the glass on cursor
            let glassX = x - (glass.offsetWidth / 2);
            let glassY = y - (glass.offsetHeight / 2);

            glass.style.left = `${glassX}px`;
            glass.style.top = `${glassY}px`;
        }

        function removeMagnify() {
            document.getElementById('magnifyingGlass').style.display = 'none';
        }

        // Quantity Logic
        function updateQuantity(change) {
            const input = document.getElementById('quantity');
            const max = parseInt(input.getAttribute('max'));
            let value = parseInt(input.value) + change;

            if (value >= 1 && value <= max) {
                input.value = value;
            }
        }

        // Cart Logic
        function addToCart(productId) {
            const quantity = document.getElementById('quantity') ? document.getElementById('quantity').value : 1;

            const button = document.querySelector('.btn-add-cart');
            const originalText = button.innerHTML;
            button.disabled = true;
            button.innerHTML = '<i class="fas fa-spinner fa-spin"></i> Adding...';

            $.ajax({
                url: "/addToCart",
                method: "POST",
                data: { productId, quantity },
                success: (response) => {
                    if (response.success) {
                        Swal.fire({
                            icon: 'success',
                            title: 'Added!',
                            text: 'Product successfully added to your bag',
                            showConfirmButton: false,
                            timer: 1500,
                            position: 'top-end',
                            toast: true
                        });
                        // Update cart count in header
                        if (response.cartCount !== undefined) {
                            $('.cart-count').text(response.cartCount);
                        }
                    } else {
                        Swal.fire({
                            icon: 'info',
                            title: 'Note',
                            text: response.message
                        });
                    }
                },
                error: (err) => {
                    const message = err.responseJSON ? err.responseJSON.message : "Something went wrong";
                    Swal.fire({
                        icon: 'error',
                        title: 'Oops...',
                        text: message
                    });
                },
                complete: () => {
                    button.disabled = false;
                    button.innerHTML = originalText;
                }
            });
        }

        function addToWishlist(productId) {
            $.ajax({
                url: '/addToWishlist',
                method: 'POST',
                data: { productId },
                success: (response) => {
                    if (response.status) {
                        Swal.fire({
                            icon: 'success',
                            title: 'Saved!',
                            text: 'Added to your wishlist',
                            showConfirmButton: false,
                            timer: 1500,
                            toast: true,
                            position: 'top-end'
                        });
                    } else {
                        Swal.fire({
                            icon: 'info',
                            text: response.message
                        });
                    }
                },
                error: () => {
                    Swal.fire({
                        icon: 'error',
                        title: 'Error',
                        text: 'Failed to add to wishlist'
                    });
                }
            });
        }
    </script>

    <%- include('../partials/user/footer') %>