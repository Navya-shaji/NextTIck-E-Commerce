<%- include("../../views/partials/admin/header") %>
    <style>
        .content-wrapper { padding: 2.5rem; background-color: var(--admin-bg); }
        .content-header { display: flex; justify-content: space-between; align-items: center; margin-bottom: 2rem; }
        .content-title { font-family: 'Outfit', sans-serif; font-size: 1.5rem; font-weight: 700; color: #1e293b; margin: 0; }
        .btn-gold { background: var(--accent-gold); color: white; border: none; padding: 0.7rem 1.5rem; border-radius: 10px; font-weight: 600; transition: all 0.2s; display: flex; align-items: center; gap: 0.5rem; }
        .btn-gold:hover { background: var(--accent-gold-hover); transform: translateY(-1px); color: white; }
        .premium-card { background: white; border-radius: 16px; box-shadow: var(--card-shadow); border: 1px solid rgba(0, 0, 0, 0.02); overflow: hidden; }
        .table thead th { background: #f8fafc; color: #64748b; font-size: 0.75rem; font-weight: 700; text-transform: uppercase; padding: 1rem 1.5rem; border: none; }
        .table tbody td { padding: 1.25rem 1.5rem; vertical-align: middle; border-top: 1px solid #f1f5f9; font-size: 0.9rem; color: #334155; }
        .status-badge { padding: 0.35rem 0.75rem; border-radius: 6px; font-size: 0.75rem; font-weight: 700; text-transform: uppercase; }
        .badge-active { background: #ecfdf5; color: #10b981; }
        .badge-upcoming { background: #fff7ed; color: #c2410c; }
        .badge-expired { background: #fff1f2; color: #e11d48; }
        .modal-content { border-radius: 16px; border: none; box-shadow: 0 10px 25px rgba(0, 0, 0, 0.1); }
        .modal-header { background: #f8fafc; border-bottom: 1px solid #e2e8f0; padding: 1.5rem; }
        .modal-title { color: #1e293b; font-weight: 700; }
        .form-label { color: #64748b; font-weight: 600; font-size: 0.85rem; }
        .form-control, .form-select { border-radius: 10px; padding: 0.7rem 1rem; border: 1px solid #e2e8f0; }
        .error-message { font-size: 0.75rem; color: #e11d48; margin-top: 0.25rem; display: none; }
        .pagination-wrap { margin-top: 2rem; display: flex; justify-content: center; }
    </style>

    <div class="content-wrapper">
        <div class="content-header">
            <h2 class="content-title">Coupon Management</h2>
            <button type="button" class="btn-gold" data-bs-toggle="modal" data-bs-target="#addCouponModal">
                <i class="fas fa-plus"></i> Create Coupon
            </button>
        </div>

        <div class="premium-card">
            <div class="table-responsive">
                <table class="table">
                    <thead>
                        <tr>
                            <th>Code</th>
                            <th>Type</th>
                            <th>Discount</th>
                            <th>Min. Purchase</th>
                            <th>Created</th>
                            <th>Expires</th>
                            <th>Status</th>
                            <th>Actions</th>
                        </tr>
                    </thead>
                    <tbody>
                        <% coupons.forEach(coupon=> { %>
                            <tr>
                                <td class="fw-bold text-dark"><%= coupon.name %></td>
                                <td><span class="badge bg-info text-capitalize"><%= coupon.couponType %></span></td>
                                <td class="text-primary fw-bold">
                                    <%= coupon.offerPrice.toFixed(2) %><%= (coupon.couponType==='percentage' ) ? '%' : '' %>
                                </td>
                                <td>₹<%= coupon.minimumPrice.toFixed(2) %></td>
                                <td class="text-muted"><%= new Date(coupon.createdOn).toLocaleDateString() %></td>
                                <td class="text-muted"><%= new Date(coupon.expireOn).toLocaleDateString() %></td>
                                <td>
                                    <% const now=new Date(); const startDate=new Date(coupon.createdOn); const
                                        expiryDate=new Date(coupon.expireOn); now.setHours(0, 0, 0, 0);
                                        startDate.setHours(0, 0, 0, 0); expiryDate.setHours(0, 0, 0, 0); 
                                        let status, badgeClass; 
                                        if (now < startDate) { status='Upcoming'; badgeClass='badge-upcoming'; } 
                                        else if (now > expiryDate) { status = 'Expired'; badgeClass = 'badge-expired'; } 
                                        else { status = 'Active'; badgeClass = 'badge-active'; }
                                    %>
                                    <span class="status-badge <%= badgeClass %>"><%= status %></span>
                                </td>
                                <td>
                                    <div class="dropdown">
                                        <button class="btn btn-sm btn-light border dropdown-toggle" type="button" data-bs-toggle="dropdown">Actions</button>
                                        <ul class="dropdown-menu dropdown-menu-end shadow-sm border-0">
                                            <li><button class="dropdown-item py-2" onclick="editCoupon('<%= coupon._id %>')"><i class="fas fa-edit me-2 text-primary"></i>Edit</button></li>
                                            <li><button class="dropdown-item py-2 text-danger" onclick="deleteCoupon('<%= coupon._id %>')"><i class="fas fa-trash me-2"></i>Delete</button></li>
                                        </ul>
                                    </div>
                                </td>
                            </tr>
                        <% }); %>
                    </tbody>
                </table>
            </div>
        </div>

        <% if (totalPages > 1) { %>
            <div class="pagination-wrap">
                <nav><ul class="pagination">
                    <% for (let i=1; i <=totalPages; i++) { %>
                        <li class="page-item <%= i === currentPage ? 'active' : '' %>"><a class="page-link" href="?page=<%= i %>"><%= i %></a></li>
                    <% } %>
                </ul></nav>
            </div>
        <% } %>
    </div>

    <!-- Add Modal -->
    <div class="modal fade" id="addCouponModal" tabindex="-1" aria-hidden="true">
        <div class="modal-dialog modal-lg">
            <div class="modal-content">
                <div class="modal-header"><h5 class="modal-title">New Coupon</h5><button type="button" class="btn-close" data-bs-dismiss="modal"></button></div>
                <form id="addCouponForm" onsubmit="handleFormSubmit(event)">
                    <div class="modal-body p-4">
                        <div class="row">
                            <div class="col-md-6 mb-3">
                                <label class="form-label">Coupon Code</label>
                                <input type="text" id="coupon-name" name="couponName" class="form-control" placeholder="e.g. SAVE20" required />
                                <div id="error-coupon-name" class="error-message"></div>
                            </div>
                            <div class="col-md-6 mb-3">
                                <label class="form-label">Coupon Type</label>
                                <select id="couponType" name="couponType" class="form-select">
                                    <option value="flat">Flat Amount (₹)</option>
                                    <option value="percentage">Percentage (%)</option>
                                </select>
                            </div>
                        </div>
                        <div class="row">
                            <div class="col-md-6 mb-3">
                                <label class="form-label">Discount Value</label>
                                <input type="number" id="offerPrice" name="offerPrice" class="form-control" step="0.01" required />
                                <div id="error-discount" class="error-message"></div>
                            </div>
                            <div class="col-md-6 mb-3">
                                <label class="form-label">Min. Purchase Amount</label>
                                <input type="number" id="minimumPrice" name="minimumPrice" class="form-control" step="0.01" value="100" required />
                                <div id="error-min-amount" class="error-message"></div>
                            </div>
                        </div>
                        <div class="row">
                            <div class="col-md-6 mb-3">
                                <label class="form-label">Start Date</label>
                                <input type="date" id="startDate" name="startDate" class="form-control" required />
                                <div id="error-start-date" class="error-message"></div>
                            </div>
                            <div class="col-md-6 mb-3">
                                <label class="form-label">Expiry Date</label>
                                <input type="date" id="endDate" name="endDate" class="form-control" required />
                                <div id="error-end-date" class="error-message"></div>
                            </div>
                        </div>
                    </div>
                    <div class="modal-footer"><button type="button" class="btn btn-light border" data-bs-dismiss="modal">Cancel</button><button type="submit" class="btn-gold">Save Coupon</button></div>
                </form>
            </div>
        </div>
    </div>

    <!-- Edit Modal -->
    <div class="modal fade" id="editCouponModal" tabindex="-1" aria-hidden="true">
        <div class="modal-dialog modal-lg">
            <div class="modal-content">
                <div class="modal-header"><h5 class="modal-title">Edit Coupon</h5><button type="button" class="btn-close" data-bs-dismiss="modal"></button></div>
                <form id="editCouponForm" onsubmit="handleEditFormSubmit(event)">
                    <input type="hidden" id="edit-coupon-id" name="couponId">
                    <div class="modal-body p-4">
                        <div class="row">
                            <div class="col-md-6 mb-3">
                                <label class="form-label">Coupon Code</label>
                                <input type="text" id="edit-coupon-name" name="couponName" class="form-control" required />
                                <div id="edit-error-coupon-name" class="error-message"></div>
                            </div>
                            <div class="col-md-6 mb-3">
                                <label class="form-label">Coupon Type</label>
                                <select id="edit-couponType" name="couponType" class="form-select">
                                    <option value="flat">Flat Amount (₹)</option>
                                    <option value="percentage">Percentage (%)</option>
                                </select>
                            </div>
                        </div>
                        <div class="row">
                            <div class="col-md-6 mb-3">
                                <label class="form-label">Discount Value</label>
                                <input type="number" id="edit-offerPrice" name="offerPrice" class="form-control" step="0.01" required />
                                <div id="edit-error-discount" class="error-message"></div>
                            </div>
                            <div class="col-md-6 mb-3">
                                <label class="form-label">Min. Purchase Amount</label>
                                <input type="number" id="edit-minimumPrice" name="minimumPrice" class="form-control" step="0.01" required />
                                <div id="edit-error-min-amount" class="error-message"></div>
                            </div>
                        </div>
                        <div class="row">
                            <div class="col-md-6 mb-3">
                                <label class="form-label">Start Date</label>
                                <input type="date" id="edit-startDate" name="startDate" class="form-control" required />
                                <div id="edit-error-start-date" class="error-message"></div>
                            </div>
                            <div class="col-md-6 mb-3">
                                <label class="form-label">Expiry Date</label>
                                <input type="date" id="edit-endDate" name="endDate" class="form-control" required />
                                <div id="edit-error-end-date" class="error-message"></div>
                            </div>
                        </div>
                    </div>
                    <div class="modal-footer"><button type="button" class="btn btn-light border" data-bs-dismiss="modal">Cancel</button><button type="submit" class="btn-gold">Update Coupon</button></div>
                </form>
            </div>
        </div>
    </div>

    <script>
        (function () {
            window.validateForm = function (prefix = '') {
                let isValid = true;
                const name = document.getElementById(prefix + 'coupon-name').value.trim();
                const type = document.getElementById(prefix + 'couponType').value;
                const discount = parseFloat(document.getElementById(prefix + 'offerPrice').value);
                const minPurchase = parseFloat(document.getElementById(prefix + 'minimumPrice').value);
                const startStr = document.getElementById(prefix + 'startDate').value;
                const endStr = document.getElementById(prefix + 'endDate').value;

                document.querySelectorAll('.error-message').forEach(el => el.style.display = 'none');

                if (!/^[A-Z0-9]+$/.test(name)) {
                    const el = document.getElementById(prefix + 'error-coupon-name');
                    el.textContent = 'Code must be uppercase and numbers only';
                    el.style.display = 'block';
                    isValid = false;
                }

                if (minPurchase < 100) {
                    const el = document.getElementById(prefix + 'error-min-amount');
                    el.textContent = 'Minimum purchase must be at least ₹100';
                    el.style.display = 'block';
                    isValid = false;
                }

                if (type === 'percentage') {
                    if (discount < 1 || discount > 90) {
                        const el = document.getElementById(prefix + 'error-discount');
                        el.textContent = 'Percentage must be between 1% and 90%';
                        el.style.display = 'block';
                        isValid = false;
                    }
                } else {
                    if (discount < 1 || discount > 100000) {
                        const el = document.getElementById(prefix + 'error-discount');
                        el.textContent = 'Flat discount must be between ₹1 and ₹1,00,000';
                        el.style.display = 'block';
                        isValid = false;
                    } else if (discount >= minPurchase) {
                        const el = document.getElementById(prefix + 'error-discount');
                        el.textContent = 'Discount must be less than minimum purchase';
                        el.style.display = 'block';
                        isValid = false;
                    }
                }

                const today = new Date(); today.setHours(0,0,0,0);
                const start = new Date(startStr + "T00:00:00");
                const end = new Date(endStr + "T23:59:59");

                if (prefix === '' && start < today) {
                    const el = document.getElementById('error-start-date');
                    el.textContent = 'Start date cannot be in the past';
                    el.style.display = 'block';
                    isValid = false;
                }

                if (end <= start) {
                    const el = document.getElementById(prefix + 'error-end-date');
                    el.textContent = 'End date must be after start date';
                    el.style.display = 'block';
                    isValid = false;
                }

                return isValid;
            };

            window.handleFormSubmit = async function (e) {
                e.preventDefault();
                if (!window.validateForm()) return;
                Swal.fire({ title: 'Processing...', allowOutsideClick: false, didOpen: () => Swal.showLoading() });
                const data = Object.fromEntries(new FormData(e.target).entries());
                try {
                    const r = await fetch('/admin/createCoupon', { method: 'POST', headers: {'Content-Type': 'application/json'}, body: JSON.stringify(data) });
                    const res = await r.json();
                    if (r.ok) window.location.reload();
                    else throw new Error(res.message || 'Failed');
                } catch (err) { Swal.fire('Error', err.message, 'error'); }
            };

            window.editCoupon = function (id) {
                fetch(`/admin/getCoupon?id=${id}`).then(r => r.json()).then(d => {
                    if (d.status) {
                        const c = d.coupon;
                        document.getElementById('edit-coupon-id').value = c._id;
                        document.getElementById('edit-coupon-name').value = c.name;
                        document.getElementById('edit-couponType').value = c.couponType;
                        document.getElementById('edit-offerPrice').value = c.offerPrice;
                        document.getElementById('edit-minimumPrice').value = c.minimumPrice;
                        document.getElementById('edit-startDate').value = new Date(c.createdOn).toISOString().split('T')[0];
                        document.getElementById('edit-endDate').value = new Date(c.expireOn).toISOString().split('T')[0];
                        new bootstrap.Modal(document.getElementById('editCouponModal')).show();
                    }
                });
            };

            window.handleEditFormSubmit = async function (e) {
                e.preventDefault();
                if (!window.validateForm('edit-')) return;
                const id = document.getElementById('edit-coupon-id').value;
                const data = Object.fromEntries(new FormData(e.target).entries());
                try {
                    const r = await fetch(`/admin/updateCoupon?id=${id}`, { method: 'POST', headers: {'Content-Type': 'application/json'}, body: JSON.stringify(data) });
                    const res = await r.json();
                    if (r.ok) window.location.reload();
                    else throw new Error(res.message || 'Update failed');
                } catch (err) { Swal.fire('Error', err.message, 'error'); }
            };

            window.deleteCoupon = function (id) {
                Swal.fire({ title: 'Delete Coupon?', text: 'This action cannot be undone.', icon: 'warning', showCancelButton: true }).then(r => {
                    if (r.isConfirmed) fetch(`/admin/deleteCoupon/${id}`, { method: 'DELETE' }).then(res => res.json()).then(d => d.success ? window.location.reload() : Swal.fire('Error', 'Failed', 'error'));
                });
            };
        })();
    </script>
<%- include("../../views/partials/admin/footer") %>